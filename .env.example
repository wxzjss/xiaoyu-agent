# 一个 OpenAI 兼容的接口地址（换成你自己的）。
# 常见的写法：https://api.deepseek.com/v1 、https://api.openai.com/v1 、
#            https://dashscope.aliyuncs.com/compatible-mode/v1 …
# 【2026-11-10】这里原来写的是某个具体服务商的地址与模型名 ——
# 那是作者本机在用的，跟使用者无关，也不该跟着源码发出去。现在留占位。
WANZI_API_KEY=
BASE_URL=
MODEL=

# Web server
PORT=8787

# 单轮工具调用上限。unlimited / 0 / inf 表示不限（默认），
# 只在你自己点「停止」或模型自己收尾时结束；填 12 就回到旧的有限模式。
MAX_ROUNDS=unlimited

# 上下文压缩：历史超过这么多 token 就把旧对话折成一条摘要，最近的尾巴原样保留。
# off / 0 / none 关闭；默认 120000。
CONTEXT_LIMIT=120000
# 压缩后保留的尾部比例（占 CONTEXT_LIMIT），默认留最近四分之一。
CONTEXT_KEEP_RATIO=0.25
