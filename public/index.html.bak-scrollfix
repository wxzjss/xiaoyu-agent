/**
 * 建一个气泡并挂上去。
 *
 * target 允许传 DocumentFragment：批量重绘历史时先离屏建好、最后一次性挂载，
 * 避免每加一条都触发一次强制同步布局（那是切会话卡顿的真凶）。
 */
function addEl(html, cls, target) {
  const d = document.createElement('div');
  d.className = cls;
  d.innerHTML = html;
  (target || log).appendChild(d);
  // 只有真的在往屏幕上加才滚动；往 fragment 里建的时候滚了也没意义
  if (!target) log.scrollTop = log.scrollHeight;
  return d;
}

function addUser(text, tag, atts, target) {
  const wrap = addEl('', 'msg user', target);
  wrap.innerHTML = '<div class="role">你' + (tag ? '<span class="interjectTag"></span>' : '') + '</div>';
  if (tag) wrap.querySelector('.interjectTag').textContent = tag;
  const list = Array.isArray(atts) ? atts.filter((a) => a && a.path) : [];
  // 附件先显示，气泡里只写打的字
  if (list.length) {
    const box = document.createElement('div');
    box.className = 'msgAttach';
    for (const a of list) {
      const chip = document.createElement("div");
      chip.className = "attachChip";
      chip.title = a.path;
      if (a.kind === "image") {
        // 刚选的带 dataUrl；刷历史时只有路径，就用预览接口拉
        const im = document.createElement("img");
        im.className = "thumb";
        im.alt = a.name || "";
        im.src = a.dataUrl || `/api/attach/raw?path=${encodeURIComponent(a.path)}`;
        im.onerror = () => {
          // 图没了就退成图标，别显示破图
          const d = document.createElement("div");
          d.className = "ficon";
          d.textContent = "🖼";
          im.replaceWith(d);
        };
        chip.appendChild(im);
      } else {
        const d = document.createElement("div");
        d.className = "ficon";
        d.textContent = a.kind === "image" ? "🖼" : "📄";
        chip.appendChild(d);
      }
      const nm = document.createElement("div");
      nm.className = "aname";
      nm.textContent = a.name;
      chip.appendChild(nm);
      box.appendChild(chip);
    }
    wrap.appendChild(box);
  }
  if (text) {
    const b = document.createElement('div');
    b.className = 'bubble';
    b.textContent = text;
    wrap.appendChild(b);
  }
}

function addAssistant() {
  const wrap = addEl('', 'msg assistant');
  wrap.innerHTML = '<div class="role">小鱼</div>';
  const b = document.createElement('div');
  b.className = 'bubble streaming';
  wrap.appendChild(b);
  return b;
}

function addTool() {
  const d = document.createElement('details');
  d.className = 'tool';
  const sum = document.createElement('summary');
  sum.innerHTML = '<span class="name"></span><span class="status"></span>';
  const pre = document.createElement('pre');
  d.append(sum, pre);
  log.appendChild(d);
  log.scrollTop = log.scrollHeight;
  return { d, sum, pre };
}

/**
 * 一整段思考折叠成一块：默认撑开边想边看，想完自动收起；点标题随时展开。
 */
function openThink() {
  const d = document.createElement('details');
  d.className = 'think';
  d.open = true;

  const sum = document.createElement('summary');
  const title = document.createElement('span');
  title.className = 'thinkTitle';
  title.textContent = '正在想…';
  const meta = document.createElement('span');
  meta.className = 'thinkMeta';
  sum.append(title, meta);

  const body = document.createElement('div');
  body.className = 'thinkBody';

  d.append(sum, body);
  log.appendChild(d);
  log.scrollTop = log.scrollHeight;

  return {
    el: d,
    push(text) {
      body.textContent += text;
      const flat = body.textContent.replace(/\s+/g, ' ').trim();
      if (flat) {
        title.textContent = flat.length > 38 ? flat.slice(0, 38) + '…' : flat;
        title.title = flat.slice(0, 400);
      }
      meta.textContent = body.textContent.length + ' 字';
      log.scrollTop = log.scrollHeight;
    },
    finish() {
      if (!body.textContent.trim()) { d.remove(); return; }
      meta.textContent = body.textContent.length + ' 字 · 点击展开';
      d.open = false;
    },
  };
}

async function stopTurn() {
  stopping = true;
  sendBtn.disabled = true;
  sendBtn.textContent = '停止中…';
  await fetch('/api/stop', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ sessionId }),
  }).catch(() => {});
}

function autosizeInput() {
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 180) + 'px';
}

/** 底部灰字「正在发送消息……」。发送时亮、这轮彻底结束就灭。 */
function showSending() {
  sendingHint.classList.add('show');
  log.scrollTop = log.scrollHeight;
}
function hideSending() {
  sendingHint.classList.remove('show');
}

/** 连 hideSending 自己都可能因为元素早没了而抛错时用它 */
function hidingSendingSafe() {
  try {
    hideSending();
  } catch {
    try { document.getElementById('sendingHint')?.classList.remove('show'); } catch {}
  }
}

/** 生成中：输入框有内容 -> 按钮变「发送」（插一句）；空着 -> 「停止」。 */
function syncSendBtn() {
  if (stopping) return;
  if (busy) {
    const has = input.value.trim().length > 0 || attachments.length > 0;
    sendBtn.textContent = has ? '发送' : '停止';
    sendBtn.classList.toggle('stop', !has);
    sendBtn.title = has ? '插一句：先停住这轮，再带着你的新话接着跑' : '停住这一轮';
  } else {
    sendBtn.textContent = '发送';
    sendBtn.classList.remove('stop');
    sendBtn.title = '';
  }
  sendBtn.disabled = false;
}

/** 跑一轮对话；resume = 接着已有历史继续（插话之后）。 */
async function runTurn({ resume = false, text = '' } = {}) {
  // 关键：这一轮属于「发起时」那个会话。中途切走、切回来都不能串台。
  const turnSession = sessionId;
  let bubble = null;
  const toolEls = new Map();
  let think = null;
  const closeThink = () => { if (think) { think.finish(); think = null; } };

  /**
   * 要不要把这一轮画到屏幕上。
   *
   * 不能只比 sessionId：删除会话、清空、切换的瞬间，界面上的 sessionId 可能已经变了，
   * 而这一轮是刚发出的、明明该显示。以前用 id 相等判断，结果事件全被当「后台」丢掉，
   * 气泡 0 个、按钮卡在「停止」。
   *
   * 现在：只要「屏幕上就是这个会话」或者「这一轮就是界面上唯一在跑的那轮」就画。
   */
  const onScreen = () => {
    if (sessionId === turnSession) return true;
    // 兜底：界面上没有别的轮次在跑，而这一轮刚发起——那它就是当前该显示的那个
    const only = turnsInFlight.size === 1 && turnsInFlight.get(turnSession) === turnRec;
    return only && !turnsInFlight.has(sessionId);
  };

  /**
   * 这一轮的后台记录：切回来时用它把已经收到的内容补画出来。
   * parts 里按顺序存 { kind: 'text'|'reasoning'|'tool', ... }
   */
  const turnRec = { sessionId: turnSession, parts: [], running: true, startedAt: Date.now() };
  turnsInFlight.set(turnSession, turnRec);

  // 这一轮要带上的附件：先快照，再清空界面上的附件条
  const sending = resume ? [] : attachments.slice();

  if (!resume) {
    input.value = '';
    autosizeInput();
    if (onScreen()) addUser(text, undefined, sending);
    attachments = [];
    renderAttachBar();
  }
  // 注意顺序：先清空输入框，再刷按钮状态，否则生成中会一直显示「发送」。
  busy = true;
  showSending();
  syncSendBtn();

  try {
    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(resume
        ? { sessionId, resume: true }
        : {
            sessionId,
            message: text,
            attachments: sending.map((a) => ({ path: a.path, name: a.name, kind: a.kind })),
          }),
    });
    if (!res.ok) {
      const e = await res.json().catch(() => ({ error: res.statusText }));
      throw new Error(e.error || 'request failed');
    }

    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      let i;
      while ((i = buf.indexOf('\n\n')) >= 0) {
        const raw = buf.slice(0, i);
        buf = buf.slice(i + 2);
        if (!raw.startsWith('data:')) continue;
        const ev = JSON.parse(raw.slice(5).trim());

        // 先把内容记进这一轮自己的记录里（不管在不在屏幕上）
        if (ev.type === 'reasoning') {
          const last = turnRec.parts[turnRec.parts.length - 1];
          if (last && last.kind === 'reasoning') last.text += ev.text;
          else turnRec.parts.push({ kind: 'reasoning', text: ev.text });
        } else if (ev.type === 'text') {
          const last = turnRec.parts[turnRec.parts.length - 1];
          if (last && last.kind === 'text') last.text += ev.text;
          else turnRec.parts.push({ kind: 'text', text: ev.text });
        } else if (ev.type === 'tool_start') {
          turnRec.parts.push({ kind: 'tool', id: ev.id, name: ev.name, args: ev.args, done: false });
        } else if (ev.type === 'tool_end') {
          const tp = turnRec.parts.find((p) => p.kind === 'tool' && p.id === ev.id);
          if (tp) {
            tp.done = true;
            tp.ok = ev.ok;
            tp.output = ev.output;
          }
        }

        // 不在屏幕上：到此为止，别往当前会话的聊天区里画
        if (!onScreen()) continue;

        /**
         * 屏幕上可能被清空过（切走再切回来，renderTurns 已经把 log 洗了）。
         * 这时候局部 bubble 指向的是已经被摘掉的旧元素，往里写等于写进黑洞。
         * 发现失效就按 turnRec 的记录全量重建一次，之后照常增量追加。
         */
        if (bubble && !bubble.isConnected) {
          bubble = null;
          think = null;
          replayInFlight(turnSession);
          bubble = turnRec.bubble || null;
          think = turnRec.think || null;
        } else if (!bubble && turnRec.bubble && turnRec.bubble.isConnected) {
          // 之前重建过，接上现有的
          bubble = turnRec.bubble;
          think = turnRec.think || null;
        }

        if (ev.type === 'reasoning') {
          if (!think) think = openThink();
          think.push(ev.text);
        } else if (ev.type === 'text') {
          closeThink();
          if (!bubble) bubble = addAssistant();
          bubble.textContent += fixMojibake(ev.text);
          log.scrollTop = log.scrollHeight;
        } else if (ev.type === 'tool_start') {
          closeThink();
          if (bubble) { bubble.classList.remove('streaming'); bubble = null; }
          const el = addTool();
          el.sum.querySelector('.name').textContent = ev.name;
          el.sum.querySelector('.status').textContent = '运行中…';
          el.pre.textContent = 'args: ' + ev.args;
          toolEls.set(ev.id, el);
        } else if (ev.type === 'tool_end') {
          const el = toolEls.get(ev.id);
          if (el) {
            const st = el.sum.querySelector('.status');
            st.textContent = ev.ok ? '完成' : '失败';
            st.className = 'status ' + (ev.ok ? 'ok' : 'err');
            el.pre.textContent += '\n--- output ---\n' + ev.output;
          }
        } else if (ev.type === 'safe_word') {
          const wrap = addEl('', 'msg user');
          wrap.innerHTML = '<div class="role">安全词<span class="safeTag"></span></div>';
          wrap.querySelector('.safeTag').textContent = ev.word;
          const b = document.createElement('div');
          b.className = 'bubble';
          b.textContent = safeWordHint(ev.word, ev.note);
          wrap.appendChild(b);
        } else if (ev.type === 'compressed') {
          const wrap = addEl('', 'msg user');
          wrap.innerHTML = '<div class="role">上下文<span class="compressTag">已压缩</span></div>';
          const b = document.createElement('div');
          b.className = 'bubble';
          b.textContent = `旧对话折成摘要了：约 ${ev.before} → ${ev.after} tokens，收起 ${ev.removed} 条`
            + (ev.limit ? `（上限 ${ev.limit}，到 ${ev.trigger} 就压）` : '')
            + (ev.error ? `（摘要失败：${ev.error}）` : '');
          wrap.appendChild(b);
          log.scrollTop = log.scrollHeight;
        } else if (ev.type === 'aborted') {
          closeThink();
          hideSending();
          if (bubble) {
            bubble.classList.remove('streaming');
            if (!pendingResume) bubble.textContent += '\n\n[已停止]';
            bubble = null;
          }
        } else if (ev.type === 'error') {
          closeThink();
          hideSending();
          if (!bubble) bubble = addAssistant();
          bubble.classList.remove('streaming');
          bubble.textContent += '\n\n⚠ ' + ev.message;
        } else if (ev.type === 'done') {
          closeThink();
          hideSending();
          if (ev.usage) {
            usageEl.textContent = `in ${ev.usage.prompt_tokens} · out ${ev.usage.completion_tokens} · total ${ev.usage.total_tokens}`;
            // 主界面：在这一轮底下留一行灰字
            appendTurnUsage(ev.usage);
          }
        }
      }
    }
  } catch (err) {
    // 先别急着报错：很可能是连接断了（进程重启 / 网络抖），这一轮其实还在服务端跑着
    const healed = await tryHealAfterDisconnect(turnSession);
    if (healed) {
      // 自愈成功：什么都不用显示，内容已经补回去了
      turnRec.parts.length = 0;
    } else if (onScreen()) {
      closeThink();
      hideSending();
      const b = bubble || addAssistant();
      b.classList.remove('streaming');
      // 说人话，不甩英文栈
      const friendly = /terminated|aborted|fetch failed|network|ECONN|socket hang up/i.test(String(err.message))
        ? '这一轮的连接断了，而且服务端那边也没在跑了。再发一句就行，记录还在。'
        : err.message;
      b.textContent += '\n\n⚠ ' + friendly;
    } else {
      turnRec.parts.push({ kind: 'text', text: '\n\n⚠ ' + err.message });
    }
  } finally {
    turnRec.running = false;
    turnsInFlight.delete(turnSession);

    // 收尾一定要复位，不然按钮永远卡在「停止」、输入框像死了一样
    closeThink();
    hideSending();
    if (bubble) bubble.classList.remove('streaming');
    stopping = false;
    // 只有「屏幕上确实是这个会话」时才把 busy 放下；
    // 但如果是同一个会话的下一轮在跑，别互相踩
    if (sessionId === turnSession || turnsInFlight.size === 0) {
      busy = false;
    }
    syncSendBtn();
    if (onScreen()) {
      if (pendingResume) {
        pendingResume = false;
        setTimeout(() => runTurn({ resume: true }), 30);
      } else {
        input.focus();
      }
    }
    refreshSessions({ silent: true }).catch(() => {});
  }
}

/** 会话 id -> 后台轮次记录（切走也不停，切回来能接着看）。在下面统一初始化。 */

/**
 * 把一个还在跑的会话「补画」到屏幕上：先把已收到的内容摆出来，后面新来的接着追加。
 */
function replayInFlight(id) {
  const rec = turnsInFlight.get(id);
  if (!rec) return false;
  let bubble = null;
  let think = null;
  for (const p of rec.parts) {
    if (p.kind === 'reasoning') {
      if (!think) think = openThink();
      think.push(p.text);
    } else if (p.kind === 'text') {
      if (think) { think.finish(); think = null; }
      if (!bubble) bubble = addAssistant();
      bubble.textContent += fixMojibake(p.text);
    } else if (p.kind === 'tool') {
      if (bubble) { bubble.classList.remove('streaming'); bubble = null; }
      const el = addTool();
      el.sum.querySelector('.name').textContent = p.name;
      const st = el.sum.querySelector('.status');
      st.textContent = p.done ? (p.ok ? '完成' : '失败') : '运行中…';
      if (p.done) st.className = 'status ' + (p.ok ? 'ok' : 'err');
      el.pre.textContent = 'args: ' + p.args + (p.done ? '\n--- output ---\n' + p.output : '');
    }
  }
  if (bubble) bubble.classList.add('streaming');
  // 存回去：切回来之后 runTurn 要接着往这几个元素上追加
  rec.bubble = bubble;
  rec.think = think;
  return true;
}

async function send() {
  if (busy) return;
  const text = input.value.trim();
  if (!text && !attachments.length) return;
  if (!sessionId) {
    try { await booted; } catch {}
    if (!sessionId) return;
  }
  await runTurn({ text });
}

/** 生成中插一句：先把这句落盘到当前会话，再停住这一轮，然后带着新话接着跑。 */
async function interject() {
  const text = input.value.trim();
  if (!busy || !text) return;
  input.value = '';
  autosizeInput();
  addUser(text, '插话');
  pendingResume = true;
  syncSendBtn();
  const r = await fetch('/api/interject', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ sessionId, message: text }),
  }).then((x) => x.json()).catch(() => null);
  if (!r || r.error) {
    pendingResume = false;
    const wrap = addEl('', 'msg user');
    wrap.innerHTML = '<div class="role">系统</div>';
    const b = document.createElement('div');
    b.className = 'bubble';
    b.textContent = '⚠ 这句没插进去：' + (r && r.error ? r.error : '网络错误');
    wrap.appendChild(b);
  }
}

sendBtn.onclick = () => {
  if (!busy) return send();
  if (input.value.trim()) return interject();
  return stopTurn();
};
input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    if (!busy) send();
    else if (input.value.trim()) interject();
  }
});
