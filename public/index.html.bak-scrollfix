/**
 * 把数字写成好看的样子：2140 -> 2,140
 * @param {number} n
 */
function fmtTok(n) {
  const v = Number(n);
  if (!Number.isFinite(v)) return '0';
  return v.toLocaleString('en-US');
}

/**
 * 往聊天区末尾加一行 token 小字。
 *
 * 服务端每轮结束的 done 事件里带 usage（整轮合计，多轮工具调用也累加了）。
 * 这里只写真实数字，不算钱 —— 各家单价不同、还有缓存命中折扣，猜一个价反而误导。
 *
 * @param {{prompt_tokens?:number, completion_tokens?:number, total_tokens?:number}} u
 */
function appendTurnUsage(u) {
  if (!u) return;
  const pin = Number(u.prompt_tokens ?? 0);
  const pout = Number(u.completion_tokens ?? 0);
  const total = Number(u.total_tokens ?? (pin + pout));
  if (!pin && !pout && !total) return; // 全 0 就别占地方

  const row = document.createElement('div');
  row.className = 'turnUsage';
  row.title = '这一轮模型实际用掉的 token（输入含系统提示与历史，输出含思考与工具调用）';

  const mk = (txt, cls) => {
    const sp = document.createElement('span');
    if (cls) sp.className = cls;
    sp.textContent = txt;
    return sp;
  };
  row.append(
    mk('↑' + fmtTok(pin) + ' 输入'),
    mk('·', 'sep'),
    mk('↓' + fmtTok(pout) + ' 输出'),
    mk('·', 'sep'),
    mk(fmtTok(total) + ' tokens', 'tt'),
  );

  log.appendChild(row);
  log.scrollTop = log.scrollHeight;
}

