    .mdlSub { color: var(--dim); font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mdlRow .mini {
      flex: none; background: transparent; color: var(--dim); border: 1px solid var(--border);
      border-radius: 6px; padding: 2px 8px; font-size: 12px; cursor: pointer;
    }
    .mdlRow .mini:hover { color: var(--text); border-color: var(--dim); }
