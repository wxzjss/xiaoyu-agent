const sessDlg = document.getElementById('sessionsDlg');
const sessList = document.getElementById('sessList');
const sessHint = document.getElementById('sessHint');

function relTime(ts) {
  if (!ts) return '';
  const d = Date.now() - ts;
  if (d < 60e3) return '刚刚';
  if (d < 3600e3) return Math.floor(d / 60e3) + ' 分钟前';
  if (d < 86400e3) return Math.floor(d / 3600e3) + ' 小时前';
  if (d < 7 * 86400e3) return Math.floor(d / 86400e3) + ' 天前';
  const t = new Date(ts);
  return `${t.getMonth() + 1}/${t.getDate()} ${String(t.getHours()).padStart(2, '0')}:${String(t.getMinutes()).padStart(2, '0')}`;
}

// 会话按钮上只留「会话」两个字，标题不再往按钮里塞（面板里能看到）。
function paintSessNow() {
  const btn = document.getElementById('openSessions');
  if (btn) btn.title = sessionTitle ? '当前会话：' + sessionTitle : '会话';
}

function renderSessList() {
  sessList.innerHTML = '';
  if (!sessionsCache.length) {
    const e = document.createElement('div');
    e.className = 'sessEmpty';
    e.textContent = '还没有会话，点上面的「＋ 新会话」开一个吧';
    sessHint.textContent = '';
    return;
  }
  sessHint.textContent = `${sessionsCache.length} 个`;
  // 展示排序：当前会话永远置顶；一句没说的空会话沉到底。
  // 为什么：空会话 updatedAt 也新，纯按时间排会把正在聊的会话顶到下面，
  // 切走再回来就得往下滚——看着就像"原来的会话没了"。
  const isEmpty = (x) => !x.count && !x.preview;
  const view = sessionsCache.slice().sort((a, b) => {
    if (a.id === sessionId) return -1;
    if (b.id === sessionId) return 1;
    const ea = isEmpty(a) ? 1 : 0;
    const eb = isEmpty(b) ? 1 : 0;
    if (ea !== eb) return ea - eb;      // 有内容的在前，空的在后
    return (b.updatedAt || 0) - (a.updatedAt || 0);
  });
  for (const s of view) {
    const row = document.createElement('div');
    row.className = 'sessRow' + (s.id === sessionId ? ' current' : '') + (isEmpty(s) ? ' sessEmptyRow' : '');
    row.dataset.id = s.id;

    const main = document.createElement('div');
    main.className = 'sessMain';
    const t = document.createElement('div');
    t.className = 'sessTitle';
    t.textContent = fixMojibake(s.title || '新会话');
    const sub = document.createElement('div');
    sub.className = 'sessSub';
    const runningNow = typeof turnsInFlight !== 'undefined' && turnsInFlight.has(s.id);
    sub.textContent = [
      runningNow ? '⏳ 还在跑' : '',
      relTime(s.updatedAt),
      s.count ? `${s.count} 句` : '',
      s.preview || '',
    ].filter(Boolean).join(' · ');
    if (runningNow) sub.classList.add('sessRunning');
    main.append(t, sub);

    const ren = document.createElement('button');
    ren.type = 'button';
    ren.className = 'mini';
    ren.dataset.act = 'rename';
    ren.textContent = '改名';

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'mini del';
    del.dataset.act = 'del';
    del.textContent = '删除';

    row.append(main, ren, del);
    sessList.appendChild(row);
  }
}

sessList.addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]');
  const row = e.target.closest('.sessRow');
  if (!row) return;
  const id = row.dataset.id;

  if (btn && btn.dataset.act === 'rename') {
    const cur = (sessionsCache.find((s) => s.id === id) || {}).title || '';
    const next = await askName({ title: '给这个会话起个名字', value: cur, maxLength: 80 });
    if (next === null) return;
    const name = next.trim();
    if (!name) return;
    const r = await fetch('/api/sessions/rename', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, title: name }),
    }).then((x) => x.json()).catch(() => null);
    if (!r || r.error) { alert('改名失败'); return; }
    if (id === sessionId) { sessionTitle = r.session.title; paintSessNow(); }
    await refreshSessions();
    return;
  }

  if (btn && btn.dataset.act === 'del') {
    const cur = (sessionsCache.find((s) => s.id === id) || {}).title || '这个会话';
    if (!confirm(`删除「${cur}」？文件会挪到 .state/sessions/.trash，还能找回。`)) return;
    const r = await fetch('/api/sessions/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    }).then((x) => x.json()).catch(() => null);
    if (!r || r.error) { alert('删除失败'); return; }
    try {
      if (id === sessionId) {
        // 删的就是当前这个：自动切到另一个（或新建一个），然后彻底回到能打字的状态
        // 先把面板关掉——它还开着就盖在输入框上面，人看着就是「点不了、打不了字」
        try { sessDlg.close(); } catch {}
        try {
          if (r.lastSessionId) await switchSession(r.lastSessionId);
          else await createSession();
        } catch (e) {
          console.warn('[del] 切会话时出错，先把输入区救回来:', e && e.message ? e.message : e);
        } finally {
          // 不管上面成不成，输入区都要能用
          settleComposer();
        }
      }
      await refreshSessions();
    } finally {
      /**
       * 删「哪一个」会话都要走到这里。
       *
       * 以前这段清场只写在「删的是当前会话」里面，删别的会话就直接 return 了，
       * 模态面板留在屏幕上盖住整个页面 —— 表现就是「删完一个会话，输入框点不了了」。
       * 现在统一收面板；这里用 closeSessPanel 而不是 settleComposer，
       * 因为当前会话可能还有一轮在跑，busy 不能被清掉。
       */
      if (id === sessionId) settleComposer();
      else closeSessPanel();
    }
    return;
  }

  if (id !== sessionId) await switchSession(id);
  sessDlg.close();
  settleComposer();
});

async function refreshSessions({ silent = false } = {}) {
  const r = await fetch('/api/sessions').then((x) => x.json()).catch(() => null);
  if (!r) {
    if (!silent) sessHint.textContent = '读取失败';
    return null;
  }
  sessionsCache = r.sessions || [];
  const cur = sessionsCache.find((s) => s.id === sessionId);
  if (cur) { sessionTitle = cur.title; paintSessNow(); }
  renderSessList();
  return r;
}

/**
 * 把一整段历史画出来。
 *
 * 用 DocumentFragment 离屏建好再一次性挂上：
 * 以前是逐条 appendChild + 每条都 log.scrollTop=scrollHeight，
 * 等于每条消息都强制一次同步布局。会话聊得久了（几百条），
 * 切回来就要卡一秒多，看着像"卡住了"。
 */
function renderTurns(turns) {
  hideSending();
  usageEl.textContent = '';

  const list = turns || [];
  const frag = document.createDocumentFragment();

  for (const turn of list) {
    if (turn.role === 'user') {
      addUser(turn.text, undefined, turn.atts, frag);
    } else {
      const wrap = addEl('', 'msg assistant', frag);
      wrap.innerHTML = '<div class="role">小鱼</div>';
      const b = document.createElement('div');
      b.className = 'bubble';
      b.textContent = fixMojibake(turn.text);
      wrap.appendChild(b);
    }
  }

  // 一次性替换 + 只滚一次
  log.replaceChildren(frag);
  log.scrollTop = log.scrollHeight;
}

async function switchSession(id) {
  const r = await fetch('/api/sessions/select', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id }),
  }).then((x) => x.json()).catch((e) => {
    console.warn('[switchSession] 切会话失败:', e && e.message ? e.message : e);
    return null;
  });
  if (!r || r.error) {
    // 打不开这个会话（多半是它已经被删了，或多个窗口共用同一目录时被别的窗口改掉了）。
    // 以前是静默 return，人看着就是"点了一下，会话没了/没反应"。现在说一句、并刷新列表。
    const why = r && r.error ? String(r.error) : '连不上服务';
    console.warn('[switchSession] 打不开会话', id, why);
    try {
      if (sessHint) {
        sessHint.textContent = why.includes('not found') ? '这个会话已经不在了，列表已刷新' : ('打不开：' + why);
        sessHint.classList.add('sessWarn');
        setTimeout(() => { try { sessHint.classList.remove('sessWarn'); } catch {} }, 4000);
      }
    } catch {}
    await refreshSessions({ silent: true });
    return false;
  }
  sessionId = r.session.id;
  sessionTitle = r.session.title;
  localStorage.setItem(STORE_KEY, sessionId);
  paintSessNow();
  loadTopCfg(); // 左上角那两个框跟着换成本会话的设置
  renderTurns(r.session.turns);

  // 这个会话还在后台跑吗？
  // 先问服务端（窗口关过也能补回来），再退回本页内存里的记录。
  // 整段包 try：补画失败只是少一段内容，绝不能连累输入框。
  try {
    const liveRunning = typeof attachLive === 'function' ? await attachLive(sessionId) : false;
    if (!liveRunning) {
      const stillRunning = typeof turnsInFlight !== 'undefined' && turnsInFlight.has(sessionId);
      if (stillRunning && typeof replayInFlight === 'function') {
        replayInFlight(sessionId);
        busy = true;
        showSending();
      } else {
        busy = false;
        hideSending();
      }
    } else {
      busy = true;
      showSending();
    }
  } catch (err) {
    console.warn('[switchSession] 补画后台进度失败（不影响输入）:', err && err.message ? err.message : err);
    busy = false;
    hidingSendingSafe();
  }
  stopping = false;
  syncSendBtn();

  renderSessList();
  // 不管上面有没有抛错，输入区都收拾干净（这条是「删会话后点不了输入框」的根治）
  settleComposer();
  return true;
}

async function createSession() {
  const r = await fetch('/api/sessions/new', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({}),
  }).then((x) => x.json()).catch(() => null);
  if (!r || !r.session) { alert('新建会话失败'); return false; }
  sessionId = r.session.id;
  sessionTitle = r.session.title;
  localStorage.setItem(STORE_KEY, sessionId);
  paintSessNow();
  loadTopCfg(); // 新会话是默认档
  log.innerHTML = '';
  hideSending();
  usageEl.textContent = '';
  // 新会话是干净的：把 busy 也归零，别让上一个会话的「发送中」锁着这里
  busy = false;
  stopping = false;
  syncSendBtn();
  await refreshSessions({ silent: true });
  settleComposer();
  return true;
}

document.getElementById('openSessions').onclick = async () => {
  await refreshSessions();
  sessDlg.showModal();
};

document.getElementById('sessNew').onclick = async () => {
  await createSession();
  sessDlg.close();
};

sessDlg.addEventListener('cancel', () => sessDlg.close());

// 进平台：自动回到最近一次会话；没有就新建一个
async function bootSessions() {
  const r = await fetch('/api/sessions').then((x) => x.json()).catch(() => null);
  if (!r) { paintSessNow(); return; }
  sessionsCache = r.sessions || [];
  const local = localStorage.getItem(STORE_KEY);
  const pick = r.lastSessionId
    || (local && sessionsCache.some((s) => s.id === local) ? local : null)
    || (sessionsCache[0] ? sessionsCache[0].id : null);
  if (pick && (await switchSession(pick))) return;
  await createSession();
}

