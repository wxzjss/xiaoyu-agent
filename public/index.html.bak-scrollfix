    {
      const acts = document.createElement('div');
      acts.className = 'acts';
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'mini edit';
      edit.textContent = '编辑';
      edit.title = m.source === 'env'
        ? '改这条（改完会存成一套独立配置，不再跟着 .env 走）'
        : '改名字 / 接口地址 / 模型名 / Key';
      edit.onclick = (e) => { e.stopPropagation(); openForm(m); };
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'mini del';
      del.textContent = '删除';
      del.title = m.source === 'env'
        ? '从列表里删掉这条（只是不再显示，.env 文件不动，随时能加回来）'
        : '把这条配置删掉';
      del.onclick = async (e) => {
        e.stopPropagation();
        if (!confirm(`删掉「${m.name}」？

只是删这条配置，别的地方不受影响。`)) return;
        const r = await fetch('/api/models/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: m.id }),
        }).then((x) => x.json()).catch(() => null);
        if (!r || r.error) { alert('删不掉：' + (r && r.error ? r.error : '网络错误')); return; }
        mdlState = r;
        if (mdlEditing === m.id) closeForm();
        paintModels();
        syncHealth();
      };
      acts.append(edit, del);
      row.appendChild(acts);
    }

    row.onclick = async () => {
      if (m.id === mdlState.activeId) return;
      const r = await fetch('/api/models/select', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: m.id }),
      }).then((x) => x.json()).catch(() => null);
      if (!r || r.error) { alert('切不了：' + (r && r.error ? r.error : '网络错误')); return; }
      mdlState = r;
      paintModels();
      syncHealth();
    };

    mdlList.appendChild(row);
  }
}

async function loadModels() {
  const r = await fetch('/api/models').then((x) => x.json()).catch(() => null);
  if (!r) return false;
  mdlState = r;
  paintModels();
  return true;
}

