const plainNow = document.getElementById('plainNow');
const optHint = document.getElementById('optHint');
const restoreEnvBtn = document.getElementById('restoreEnv');

let thinkState = { level: 'auto', perModel: {}, levels: [] };
let r429State = { config: { enabled: true, migrateThreshold: 3 }, cooldownLeft: 0, migrating: false };
let plainState = { plainTalk: true };

const FALLBACK_LEVELS = [
  { id: 'off', name: '关', desc: '不要思考，最快最省' },
  { id: 'minimal', name: '最低', desc: '极轻任务' },
  { id: 'low', name: '低', desc: '简单对话，便宜又快' },
  { id: 'medium', name: '中', desc: '中等强度' },
  { id: 'high', name: '高', desc: '官方默认档' },
  { id: 'xhigh', name: '特高', desc: '更狠一点' },
  { id: 'max', name: '最高', desc: '重任务' },
  { id: 'auto', name: '自动', desc: '要调工具用高档，纯聊天用低档' },
];

function paintThink() {
  if (!thinkSel) return;
  // 接口没回来的话也得有东西可选
  if (!Array.isArray(thinkState.levels) || !thinkState.levels.length) {
    thinkState.levels = FALLBACK_LEVELS;
  }
  // 当前选中的模型优先显示它自己的档位，没设过就显示全局
  const curModel = mdlState.activeId;
  const own = curModel ? thinkState.perModel[curModel] : undefined;
  const eff = own ?? thinkState.level;

  thinkSel.innerHTML = '';
  for (const lv of thinkState.levels) {
    const o = document.createElement('option');
    o.value = lv.id;
    o.textContent = lv.name + (lv.id === 'auto' ? '（推荐）' : '');
    o.title = lv.desc;
    if (lv.id === eff) o.selected = true;
    thinkSel.appendChild(o);
  }
  const nameOf = (id) => (thinkState.levels.find((l) => l.id === id) || {}).name || id;
  thinkNow.textContent = own ? '· 这个模型：' + nameOf(own) : '· 全局：' + nameOf(thinkState.level);
}

function paintR429() {
  if (!r429Sw) return;
  const on = Boolean(r429State.config?.enabled);
  r429Sw.textContent = on ? '已开启' : '已关闭';
  r429Sw.className = 'switch' + (on ? ' on' : '');
  const cool = r429State.cooldownLeft;
  r429Now.textContent = cool > 0 ? `· 冷却中 ${cool}s` : on ? `· 连撞 ${r429State.config?.migrateThreshold ?? 3} 次换会话` : '';
}

function paintPlain() {
  if (!plainSw) return;
  const on = Boolean(plainState.plainTalk);
  plainSw.textContent = on ? '已开启' : '已关闭';
  plainSw.className = 'switch' + (on ? ' on' : '');
  plainNow.textContent = on ? '· 不啰嗦' : '';
}

async function loadOptions() {
  const [t, r, c] = await Promise.all([
    fetch('/api/thinking').then((x) => x.json()).catch(() => null),
    fetch('/api/retry429').then((x) => x.json()).catch(() => null),
    fetch('/api/chatstyle').then((x) => x.json()).catch(() => null),
  ]);
  if (t) thinkState = t;
  if (r) r429State = r;
  if (c) plainState = c;
  paintThink();
  paintR429();
  paintPlain();
}

if (thinkSel) {
  thinkSel.onchange = async () => {
    const level = thinkSel.value;
    const modelId = mdlState.activeId;
    if (optHint) optHint.textContent = '保存中…';
    // 有选中的模型就只改它自己的；没有模型才动全局默认
    const payload = modelId ? { modelId, modelLevel: level } : { level };
    const r = await fetch('/api/thinking/set', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    }).then((x) => x.json()).catch(() => null);
    if (!r || r.error) {
      if (optHint) optHint.textContent = '存不上：' + (r && r.error ? r.error : '网络错误');
      return;
    }
    thinkState = r;
    paintThink();
    if (optHint) optHint.textContent = '思考档位已改成「' + (thinkState.levels.find((l) => l.id === level)?.name || level) + '」，下一句生效';
  };
}

if (r429Sw) {
  r429Sw.onclick = async () => {
    const next = !r429State.config?.enabled;
    r429Sw.disabled = true;
    const r = await fetch('/api/retry429/set', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: next }),
    }).then((x) => x.json()).catch(() => null);
    r429Sw.disabled = false;
    if (!r || r.error) {
      if (optHint) optHint.textContent = '操作失败：' + (r && r.error ? r.error : '网络错误');
      return;
    }
    r429State = r;
    paintR429();
    if (optHint) optHint.textContent = next ? '撞 429 会自动回退换会话' : '撞 429 不再自动回退';
  };
}

if (plainSw) {
  plainSw.onclick = async () => {
    const next = !plainState.plainTalk;
    plainSw.disabled = true;
    const r = await fetch('/api/chatstyle/set', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ plainTalk: next }),
    }).then((x) => x.json()).catch(() => null);
    plainSw.disabled = false;
    if (!r || r.error) {
      if (optHint) optHint.textContent = '操作失败：' + (r && r.error ? r.error : '网络错误');
      return;
    }
    plainState = r;
    paintPlain();
    if (optHint) optHint.textContent = next ? '少说教已开（底线不变）' : '少说教已关';
  };
}

// .env 那条被删掉了才需要「找回」
function paintRestoreEnv() {
  if (!restoreEnvBtn) return;
  const hasEnv = mdlState.models.some((m) => m.id === 'env');
  restoreEnvBtn.hidden = hasEnv || !mdlState.envDefaults?.hasKey;
}

if (restoreEnvBtn) {
  restoreEnvBtn.onclick = async () => {
    const r = await fetch('/api/models/restore-env', { method: 'POST' }).then((x) => x.json()).catch(() => null);
    if (!r || r.error) { alert('找回失败'); return; }
    mdlState = r;
    paintModels();
    paintRestoreEnv();
    if (optHint) optHint.textContent = '已把 .env 那条加回列表';
  };
}

document.getElementById('openModels').onclick = async () => {
  closeForm();
  const ok = await loadModels();
  if (!ok) { alert('读取模型列表失败'); return; }
  await loadOptions();
  paintRestoreEnv();
  if (optHint) optHint.textContent = '';
  mdlDlg.showModal();
};

document.getElementById('mdlAdd').onclick = () => openForm(null);
document.getElementById('mdlEmptyAdd').onclick = () => openForm(null);
document.getElementById('mdlCancel').onclick = () => closeForm();

document.getElementById('mdlTest').onclick = async () => {
  const payload = formPayload();
  if (!payload.model || !payload.baseURL) { clearFormHint('err', '地址和模型名先填上'); return; }
  clearFormHint('', '正在连…');
  const r = await fetch('/api/models/test', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }).then((x) => x.json()).catch(() => null);
  if (!r) { clearFormHint('err', '网络错误'); return; }
  if (r.error) { clearFormHint('err', r.error); return; }
  clearFormHint('ok', `通了，${r.ms}ms`);
};

document.getElementById('mdlSave').onclick = async () => {
  const payload = formPayload();
  if (!payload.model) { clearFormHint('err', '模型名不能空'); return; }
  if (!payload.baseURL) { clearFormHint('err', '接口地址不能空'); return; }
  clearFormHint('', '保存中…');
  const r = await fetch('/api/models/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }).then((x) => x.json()).catch(() => null);
  if (!r) { clearFormHint('err', '保存失败：网络错误'); return; }
  if (r.error) { clearFormHint('err', r.error); return; }
  mdlState = r;
  closeForm();
  paintModels();
  syncHealth();
};

const booted = bootSessions();


</script>
</body>
</html>
