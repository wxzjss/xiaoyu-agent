      border: 1px solid var(--err); border-radius: 999px; padding: 1px 9px; margin-left: 8px;
      vertical-align: middle;
    }

    /* ---- 模型面板 ---- */
    .mdlScroll { overflow-y: auto; max-height: calc(86vh - 118px); }
    .mdlList { padding: 8px; }
    .mdlRow {
      display: flex; align-items: center; gap: 10px; padding: 10px 12px;
      border: 1px solid transparent; border-radius: 8px; cursor: pointer;
    }
    .mdlRow:hover { background: #1d2430; border-color: var(--border); }
