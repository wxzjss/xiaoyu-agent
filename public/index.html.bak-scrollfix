    main.className = 'mdlMain';
    const nameLine = document.createElement('div');
    nameLine.className = 'mdlName';
    nameLine.textContent = m.name;
    if (m.id === mdlState.activeId) {
      const b = document.createElement('span');
      b.className = 'badge';
      b.textContent = '正在用';
      nameLine.appendChild(b);
    }
    if (m.source === 'env') {
      const b = document.createElement('span');
      b.className = 'badge env';
      b.textContent = '.env';
      nameLine.appendChild(b);
    }
    const sub = document.createElement('div');
    sub.className = 'mdlSub';
    sub.textContent = `${m.model} · ${m.baseURL} · ${m.hasKey ? m.keyHint : '没填 Key'}`;
    main.append(nameLine, sub);
