// ---- 一个自己画的「让你输一句话」小框 --------------------------------------
/**
 * 为什么不用 prompt：Electron 里 window.prompt 不会弹框，直接返回 null。
 * 以前「改名」点了没反应就栽在这儿 —— 拿到的永远是 null，代码当成取消就 return 了。
 *
 * @param {object} opts
 * @param {string} opts.title 标题
 * @param {string} [opts.value] 预填内容
 * @param {string} [opts.placeholder] 空的时候灰字提示
 * @param {number} [opts.maxLength] 最多几个字
 * @returns {Promise<string|null>} 确定给字符串，取消给 null
 */
function askName({ title, value = '', placeholder = '', maxLength = 80 } = {}) {
  return new Promise((resolve) => {
    const dlg = document.getElementById('askDlg');
    const t = document.getElementById('askTitle');
    const input = document.getElementById('askInput');
    const hint = document.getElementById('askHint');
    const okBtn = document.getElementById('askOk');
    const cancelBtn = document.getElementById('askCancel');

    t.textContent = title || '起个名字';
    input.value = value;
    input.placeholder = placeholder;
    input.maxLength = maxLength;
    hint.textContent = '';

    let done = false;
    const finish = (val) => {
      if (done) return;
      done = true;
      // 监听一次性用完就摘，别越堆越多
      input.oninput = null;
      cancelBtn.onclick = null;
      okBtn.onclick = null;
      dlg.onclose = null;
      try { if (dlg.open) dlg.close(); } catch {}
      resolve(val);
    };

    const syncOk = () => {
      const empty = !input.value.trim();
      okBtn.disabled = empty;
      okBtn.style.opacity = empty ? '.5' : '1';
      okBtn.style.cursor = empty ? 'not-allowed' : 'pointer';
    };
    input.oninput = () => { hint.textContent = ''; syncOk(); };
    cancelBtn.onclick = () => finish(null);
    // Esc 关掉也算取消
    dlg.onclose = () => finish(null);
    // 回车 / 点确定
    okBtn.onclick = (e) => {
      e.preventDefault();
      if (!input.value.trim()) return;
      finish(input.value);
    };

    syncOk();
    dlg.showModal();
    input.focus();
    input.select();
  });
}

