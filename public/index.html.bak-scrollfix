function closeCfgMenu() {
  cfgMenu.classList.remove('open');
  topModel.classList.remove('open');
  topThink.classList.remove('open');
  cfgMenuFor = null;
}

function openCfgMenu(which) {
  if (!sessionId) return;
  if (cfgMenuFor === which) { closeCfgMenu(); return; }
  cfgMenuFor = which;
  topModel.classList.toggle('open', which === 'model');
  topThink.classList.toggle('open', which === 'think');
  cfgMenuList.innerHTML = '';

  if (which === 'model') {
    cfgMenuHead.textContent = '换模型（只影响这个会话）';
    const list = cfgState.models || [];
    if (!list.length) {
      cfgMenuList.innerHTML = '<div class="cfgMenuHead">还没有别的模型，去右上角「模型」里加</div>';
    }
    for (const m of list) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'cfgMenuItem';
      const on = cfgState.isModelCustom ? cfgState.modelId === m.id : !cfgState.isModelCustom && m.active;
      b.innerHTML = '<span class="ck">' + (on ? '✓' : '') + '</span>';
      const nm = document.createElement('span');
      nm.textContent = m.name;
      nm.style.overflow = 'hidden';
      nm.style.textOverflow = 'ellipsis';
      b.appendChild(nm);
      b.onclick = () => setSessionCfg({ modelId: m.id === cfgState.modelId && cfgState.isModelCustom ? '' : m.id });
      cfgMenuList.appendChild(b);
    }
    // 回默认
    const back = document.createElement('button');
    back.type = 'button';
    back.className = 'cfgMenuItem';
    back.innerHTML = '<span class="ck">' + (cfgState.isModelCustom ? '' : '✓') + '</span>';
    const t = document.createElement('span');
    t.textContent = '默认（跟右上角一致）';
    back.appendChild(t);
    back.onclick = () => setSessionCfg({ modelId: '' });
    cfgMenuList.appendChild(back);
  } else {
    cfgMenuHead.textContent = '换思考强度（只影响这个会话）';
    // 「默认」第一项
    const def = document.createElement('button');
    def.type = 'button';
    def.className = 'cfgMenuItem';
    def.innerHTML = '<span class="ck">' + (cfgState.isLevelCustom ? '' : '✓') + '</span>';
    const dt = document.createElement('span');
    dt.textContent = '默认';
    def.appendChild(dt);
    const dd = document.createElement('span');
    dd.className = 'desc';
    dd.textContent = cfgState.defaultLevelName ? `跟模型走（${cfgState.defaultLevelName}）` : '跟模型设置走';
    def.appendChild(dd);
    def.onclick = () => setSessionCfg({ level: '' });
    cfgMenuList.appendChild(def);

    for (const lv of cfgState.levels || []) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'cfgMenuItem';
      b.innerHTML = '<span class="ck">' + (cfgState.level === lv.id ? '✓' : '') + '</span>';
      const nm = document.createElement('span');
      nm.textContent = lv.name;
      b.appendChild(nm);
      if (lv.desc) {
        const d = document.createElement('span');
        d.className = 'desc';
        d.textContent = lv.desc;
        d.title = lv.desc;
        b.appendChild(d);
      }
      b.onclick = () => setSessionCfg({ level: lv.id });
      cfgMenuList.appendChild(b);
    }
  }

  // 摆到框下面
  const anchor = which === 'model' ? topModel : topThink;
  const r = anchor.getBoundingClientRect();
  cfgMenu.style.left = Math.round(r.left) + 'px';
  cfgMenu.style.top = Math.round(r.bottom + 6) + 'px';
  cfgMenu.classList.add('open');
}

async function setSessionCfg(patch) {
  if (!sessionId) return;
  const r = await fetch('/api/session-config/set', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ sessionId, ...patch }),
  }).then((x) => x.json()).catch(() => null);
  closeCfgMenu();
  if (!r || r.error) { alert('没设上：' + (r && r.error ? r.error : '网络错误')); return; }
  cfgState = { ...cfgState, ...r };
  paintTopCfg();
  if (meta) meta.title = (meta.title || '') ;
}

