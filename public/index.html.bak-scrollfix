    .hint.ok { color: var(--ok); }
    .hint.err { color: var(--err); }

    /* ---- 模型面板底部的选项 ---- */
    .mdlOpts { border-top: 1px solid var(--border); padding: 6px 8px 0; }
    .optRow {
      display: flex; align-items: center; gap: 12px; padding: 10px 12px;
