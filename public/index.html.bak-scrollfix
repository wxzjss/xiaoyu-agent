function clearFormHint(kind = '', text = '') {
  mdlFormHint.className = 'hint' + (kind ? ' ' + kind : '');
  mdlFormHint.textContent = text;
}

function openForm(model) {
  mdlEditing = model ? model.id : null;
  mdlFormTitle.textContent = model ? `编辑模型：${model.name}` : '添加模型';
  mdlName.value = model ? (model.source === 'env' ? model.model : model.name) : '';
  mdlModel.value = model ? model.model : (mdlState.envDefaults?.model ?? '');
  mdlBase.value = model ? model.baseURL : (mdlState.envDefaults?.baseURL ?? '');
  mdlKey.value = '';
  mdlKey.placeholder = model && model.hasKey
    ? `已保存 ${model.keyHint}，不改就留空`
    : 'sk-...';
  clearFormHint();
  mdlEmpty.hidden = true; // 空状态和表单别同时杵在屏幕上
  mdlForm.classList.remove('hidden');
  mdlName.focus();
}

function closeForm() {
  mdlEditing = null;
  mdlForm.classList.add('hidden');
  clearFormHint();
  mdlEmpty.hidden = !mdlState.empty;
}

function paintModels() {
  mdlCount.textContent = mdlState.models.length ? `共 ${mdlState.models.length} 个` : '';
  if (typeof paintRestoreEnv === 'function') paintRestoreEnv();
  mdlList.innerHTML = '';
