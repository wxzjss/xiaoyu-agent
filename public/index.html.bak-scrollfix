  <script>
const log = document.getElementById('log');
const input = document.getElementById('input');
const sendBtn = document.getElementById('send');
const meta = document.getElementById('meta');
const usageEl = document.getElementById('usage');
const sendingHint = document.getElementById('sendingHint');
let busy = false;

// ===== 加号附件：文件 / 图片 =====
const plusBtn = document.getElementById("plusBtn");
const plusMenu = document.getElementById("plusMenu");
const attachBar = document.getElementById("attachBar");
const pickMask = document.getElementById("pickMask");
const pickCols = document.getElementById("pickCols");
const pickCrumbs = document.getElementById("pickCrumbs");
const pickCrumb = document.getElementById("pickCrumb");
const pickTitle = document.getElementById("pickTitle");
const pickNote = document.getElementById("pickNote");
const pickOk = document.getElementById("pickOk");
const pickHidden = document.getElementById("pickHidden");
const dropMask = document.getElementById("dropMask");
const dropDesc = document.getElementById("dropDesc");

/** 这轮要带上的附件：{path,name,kind,size,dataUrl?} */
let attachments = [];
/** 浮层当前状态 */
/**
 * 浮层当前状态。
 *
 * levels 是一个栈，一层目录一栏：进去一个文件夹就压一层，点「上一级」就弹一层。
 * 这就是 dsh 那种栏式浏览的骨架 —— 路径本身就是界面，不用另做面包屑跳转表。
 * sel 记的是选中的文件（path -> 文件信息），Map 是为了顺手去重。
 */
const pick = { open: false, kind: "file", levels: [], sel: new Map(), hidden: false, dir: "", lastDir: "" };

const IMG_EXT = /\.(png|jpe?g|gif|webp|bmp|ico|avif|svg)$/i;
function isImg(p) { return IMG_EXT.test(String(p || "")); }
function fmtSize(n) {
  if (n == null) return "";
  if (n < 1024) return n + " B";
  if (n < 1024 * 1024) return (n / 1024).toFixed(0) + " KB";
  return (n / 1024 / 1024).toFixed(1) + " MB";
}
function baseName(p) { return String(p || "").split(/[\\/]/).pop() || p; }

// ---- 加号菜单开合 ----
function setMenu(open) {
  plusMenu.classList.toggle("open", open);
  plusBtn.setAttribute("aria-expanded", open ? "true" : "false");
}
plusBtn.addEventListener("click", (e) => {
  e.stopPropagation();
  if (plusBtn.disabled) return;
  setMenu(!plusMenu.classList.contains("open"));
});
document.addEventListener("click", (e) => {
  if (!plusMenu.classList.contains("open")) return;
  if (plusMenu.contains(e.target) || e.target === plusBtn) return;
  setMenu(false);
});
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && plusMenu.classList.contains("open")) setMenu(false);
});

// ---- 附件条渲染 ----
function renderAttachBar() {
  attachBar.innerHTML = "";
  if (!attachments.length) { attachBar.classList.remove("show"); return; }
  attachBar.classList.add("show");
  attachments.forEach((a, i) => {
    const chip = document.createElement("div");
    chip.className = "attachChip";
    chip.title = a.path;
    if (a.kind === "image" && a.dataUrl) {
      const im = document.createElement("img");
      im.className = "thumb";
      im.src = a.dataUrl;
      im.alt = a.name;
      chip.appendChild(im);
    } else {
      const d = document.createElement("div");
      d.className = "ficon";
      d.textContent = a.kind === "image" ? "🖼" : "📄";
      chip.appendChild(d);
    }
    const nm = document.createElement("div");
    nm.className = "aname";
    nm.textContent = a.name;
    chip.appendChild(nm);
    if (a.size) {
      const sz = document.createElement("div");
      sz.className = "asize";
      sz.textContent = fmtSize(a.size);
      chip.appendChild(sz);
    }
    const rm = document.createElement("button");
    rm.type = "button";
    rm.className = "arm";
    rm.textContent = "×";
    rm.title = "移掉";
    rm.onclick = () => { attachments.splice(i, 1); renderAttachBar(); syncSendBtn(); };
    chip.appendChild(rm);
    attachBar.appendChild(chip);
  });
}

function addAttachment(item) {
  if (!item || !item.path) return;
  if (attachments.some((a) => a.path === item.path)) return; // 同一个不加两次
  attachments.push({
    path: item.path,
    name: item.name || baseName(item.path),
    kind: item.kind || (isImg(item.path) ? "image" : "file"),
    size: item.size,
    dataUrl: item.dataUrl,
  });
  renderAttachBar();
  syncSendBtn();
}

// ---- 打开浮层：栏式浏览 ----
const PICK_COL_W = 238;

/** 问后端要一层目录的内容 */
async function fetchLevel(dir) {
  const r = await fetch(`/api/attach/browse?kind=${pick.kind}&path=${encodeURIComponent(dir || "")}`).then((x) => x.json());
  if (r.error) throw new Error(r.error);
  return r;
}

/** 一层目录里的文件夹名，给选中的文件夹做预览用 */
function childDirs(lv) {
  return (lv.dirs || []).filter((d) => pick.hidden || !d.name.startsWith("."));
}

async function openPicker(kind) {
  setMenu(false);
  pick.open = true;
  pick.kind = kind === "image" ? "image" : "file";
  pick.sel = new Map();
  pick.hidden = false;
  pickHidden.checked = false;
  pickTitle.textContent = pick.kind === "image" ? "选择图片" : "选择文件";
  pickOk.textContent = "插入" + (pick.kind === "image" ? "图片" : "文件");
  pickCols.innerHTML = '<div class="pickEmpty">正在读取…</div>';
  pickMask.classList.add("open");
  try {
    // 起点是上次用过的目录；没有就从盘根开始
    const start = pick.lastDir || "";
    pick.dir = "";
    pick.levels = await chainTo(start);
    renderCols();
    pickCols.scrollLeft = pickCols.scrollWidth;
  } catch (err) {
    pickCols.innerHTML = `<div class="pickEmpty">读不了这个目录：${String(err.message || err)}</div>`;
  }
}

/** 面包屑跳转：只留「盘根 → 这一层」的链 */
async function jumpTo(dir) {
  return chainTo(dir);
}

function closePicker() {
  pick.open = false;
  pick.sel = new Map();
  pick.levels = [];
  pickMask.classList.remove("open");
  pickCols.innerHTML = "";
  pickCrumbs.textContent = "";
}

/** 选 / 取消选一个文件；图片模式是单选 */
function toggleFile(f, forceOn) {
  const on = pick.sel.has(f.path);
  if (pick.kind === "image") {
    pick.sel.clear();
    if (!on || forceOn) pick.sel.set(f.path, f);
  } else if (on && !forceOn) {
    pick.sel.delete(f.path);
  } else {
    pick.sel.set(f.path, f);
  }
  renderCols();
}

/**
 * 点一个文件夹：选它，并把它的下一层铺到右边那一栏。
 *
 * 这就是 dsh 那种「选中靠右、子项在右栏」的走法。
 * 再点一次同一个文件夹就当取消选中，回到浏览。
 */
/**
 * 点文件夹：只保留「盘根 → 它」这条链，每层一栏，最后再把它自己铺成一栏。
 * 这样绝不会出现同一层目录铺两遍。
 */
async function selectDir(d, idx) {
  if (pick.dir === d.path) {
    pick.dir = "";
    pick.levels = await chainTo(pick.levels[idx].dir);
    renderCols();
    return;
  }
  pick.dir = d.path;
  try {
    pick.levels = await chainTo(d.path);
    renderCols();
  } catch (err) {
    pick.dir = "";
    alert("进不去这个目录：" + String(err.message || err));
  }
}

/**
 * 把「盘根 → dir」这条链读成一串层级，每层一栏。
 * chainTo('C:\\some\\dir') -> [C:\ 的内容, C:\some 的内容, C:\some\dir 的内容]
 * 面包屑跳转和点文件夹都走它，所以永远不会铺重复的一层。
 */
async function chainTo(dir) {
  const lv = await fetchLevel(dir);
  if (!lv.parent) return [lv];
  const chain = [lv];
  let cur = lv.parent;
  const seen = new Set([lv.dir]);
  while (cur && !seen.has(cur)) {
    seen.add(cur);
    const up = await fetchLevel(cur);
    chain.unshift(up);
    cur = up.parent;
  }
  return chain;
}

function renderCols() {
  pickCols.innerHTML = "";

  pick.levels.forEach((lv, idx) => {
    const col = document.createElement("div");
    col.className = "pickCol";

    // ---- 文件夹：点一下就选中它，同时把里面铺到右边那一栏 ----
    for (const d of lv.dirs || []) {
      if (!pick.hidden && d.name.startsWith(".")) continue;
      const isSel = pick.dir === d.path;
      const row = document.createElement("div");
      row.className = "pickRow dir" + (isSel ? " sel" : "");
      row.title = d.path;
      const ic = document.createElement("span");
      ic.className = "pico";
      ic.textContent = isSel ? "📂" : "📁";
      row.appendChild(ic);
      const nm = document.createElement("div");
      nm.className = "pname";
      nm.textContent = d.name;
      row.appendChild(nm);
      // 选中行带右箭头，跟 dsh 里一样：有箭头就是「往右还有一栏」
      const go = document.createElement("span");
      go.className = "pgo";
      go.textContent = "›";
      row.appendChild(go);
      row.onclick = () => selectDir(d, idx);
      col.appendChild(row);
    }

    // ---- 文件：单击就选中（多选），双击直接插入 ----
    for (const f of lv.files || []) {
      if (!pick.hidden && f.name.startsWith(".")) continue;
      const on = pick.sel.has(f.path);
      const row = document.createElement("div");
      row.className = "pickRow file" + (on ? " sel" : "");
      row.title = f.path;
      const ic = document.createElement("span");
      ic.className = "pico";
      if (f.isImage) {
        const im = document.createElement("img");
        im.loading = "lazy";
        im.alt = "";
        im.src = `/api/attach/raw?path=${encodeURIComponent(f.path)}`;
        im.onerror = () => { im.replaceWith(Object.assign(document.createElement("span"), { className: "pico", textContent: "🖼" })); };
        row.appendChild(im);
      } else {
        ic.textContent = "📄";
        row.appendChild(ic);
      }
      const nm = document.createElement("div");
      nm.className = "pname";
      nm.textContent = f.name;
      row.appendChild(nm);
      const mt = document.createElement("div");
      mt.className = "pmeta";
      mt.textContent = fmtSize(f.size);
      row.appendChild(mt);
      const go = document.createElement("span");
      go.className = "pgo";
      go.textContent = on ? "›" : "";
      row.appendChild(go);
      row.onclick = () => toggleFile(f);
      row.ondblclick = () => { toggleFile(f, true); commitPick(); };
      col.appendChild(row);
    }

    if (!col.children.length) {
      const e = document.createElement("div");
      e.className = "pickEmpty";
      e.textContent = "这层是空的";
      col.appendChild(e);
    }
    pickCols.appendChild(col);
  });

  // 面包屑：点任意一段直接回到那一层
  const last = pick.levels[pick.levels.length - 1];
  pickCrumb.value = last ? last.dir : "";
  pickCrumb.title = pickCrumb.value;
  renderCrumbs();
  updatePickNote();
  // 每次重画都滚到最右边那一栏，跟点进去的方向一致
  pickCols.scrollLeft = pickCols.scrollWidth;
}

/** 把一条绝对路径（比如 C:\some\dir）拆成可点的几段 */
function renderCrumbs() {
  pickCrumbs.innerHTML = "";
  const last = pick.levels[pick.levels.length - 1];
  if (!last) return;
  const full = last.dir;
  const win = /^[A-Za-z]:[\\/]/.test(full);
  const segs = [];
  let acc = "";
  if (win) {
    // C:\ -> C:   C:\some\dir -> C:, some, dir
    const drive = full.slice(0, 2);
    segs.push({ name: drive, path: drive + "\\" });
    acc = drive + "\\";
    const rest = full.slice(2).split(/[\\/]+/).filter(Boolean);
    for (const s of rest) {
      acc = acc.replace(/[\\/]+$/, "") + "\\" + s;
      segs.push({ name: s, path: acc });
    }
  } else {
    for (const s of full.split("/").filter(Boolean)) {
      acc = acc + "/" + s;
      segs.push({ name: s, path: acc || "/" });
    }
    if (!segs.length) segs.push({ name: "/", path: "/" });
  }
  segs.forEach((seg, i) => {
    if (i) {
      const sp = document.createElement("span");
      sp.className = "pcsep";
      sp.textContent = "›";
      pickCrumbs.appendChild(sp);
    }
    const b = document.createElement("button");
    b.type = "button";
    b.className = "pcseg" + (i === segs.length - 1 ? " cur" : "");
    b.textContent = seg.name;
    b.title = seg.path;
    b.onclick = async () => {
      pick.dir = "";
      try {
        pick.levels = await jumpTo(seg.path);
        renderCols();
      } catch (err) {
        alert("这个路径打不开：" + String(err.message || err));
      }
    };
    pickCrumbs.appendChild(b);
  });
}

function updatePickNote() {
  const n = pick.sel.size;
  pickNote.textContent = n
    ? `已选 ${n} 个`
    : (pick.kind === "image"
        ? "点一张图片选中，双击直接插入"
        : "点左边文件夹往右走，点文件选中（可多选），双击直接插入");
  pickOk.disabled = n === 0;
  pickOk.style.opacity = n ? "1" : ".5";
  pickOk.style.cursor = n ? "pointer" : "not-allowed";
}

async function commitPick() {
  const picked = [...pick.sel.values()];
  if (!picked.length) return;
  const lastLv = pick.levels[pick.levels.length - 1];
  if (lastLv && lastLv.dir) pick.lastDir = lastLv.dir;
  for (const f of picked) {
    const kind = isImg(f.path) ? "image" : "file";
    let dataUrl;
    if (kind === "image") {
      try {
        const r = await fetch(`/api/attach/preview?path=${encodeURIComponent(f.path)}`).then((x) => x.json());
        if (r && r.dataUrl) dataUrl = r.dataUrl;
      } catch {}
    }
    addAttachment({ path: f.path, name: f.name || baseName(f.path), kind, size: f.size, dataUrl });
  }
  closePicker();
  input.focus();
}

document.getElementById("pickFile").onclick = () => openPicker("file");
document.getElementById("pickImage").onclick = () => openPicker("image");
document.getElementById("pickClose").onclick = closePicker;
document.getElementById("pickCancel").onclick = closePicker;
document.getElementById("pickOk").onclick = commitPick;
pickCrumb.addEventListener("keydown", async (e) => {
  if (e.key !== "Enter") return;
  e.preventDefault();
  pick.dir = "";
  try {
    pick.levels = await jumpTo(pickCrumb.value.trim());
    renderCols();
  } catch (err) {
    alert("这个路径打不开：" + String(err.message || err));
  }
});
pickHidden.onchange = () => { pick.hidden = pickHidden.checked; renderCols(); };
pickMask.addEventListener("click", (e) => { if (e.target === pickMask) closePicker(); });
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && pick.open) closePicker();
});

// ---- 坏字修复：老数据里可能带着问号方块，显示前必须收拾干净 ------------------
/**
 * 老会话 / 老设置是坏着存下来的：中文被写成 \uFFFD，界面上就是个问号方块。
 *
 * 两条路分开走，别混：
 *   1. 孤立的单个方块 —— 一般是标点，按位置补回来（句末「。」，中间「，」）
 *   2. 连着两个以上 —— 整段文字当年就毁了，猜不回来。硬猜会把原文改错，
 *      所以只把它换成看得懂的「□」，一眼就知道「这里原本有字，坏了」。
 *
 * @param {string} text
 * @returns {string}
 */
function fixMojibake(text) {
  if (typeof text !== 'string' || !text.includes('\uFFFD')) return text;

  // 连续的：换成「□」，保留「几个字坏了」的感觉
  let t = text.replace(/\uFFFD{2,}/g, (m) => '□'.repeat(Math.min(m.length, 8)));

  // 孤立的单块：按位置判标点
  t = t.replace(/\uFFFD(?=[ \t]*(?:\n|"|$))/g, '。');
  t = t.replace(/\uFFFD(?=[ \t]*[\u4e00-\u9fa5])/g, '，');
  t = t.replace(/(?<=[\u4e00-\u9fa5])\uFFFD(?=[\u4e00-\u9fa5])/g, '，');
  t = t.replace(/\uFFFD/g, ' ');
  return t;
}

// ---- 安全词提示：每个词干的事不一样，别都显示同一句 ----------------------
/**
 * 老版本的事件里只带 word，不带 note，所以这里留一份兜底表。
 * 表里没有的（主人自己加的）就先说「已触发」再附上词本身，绝不硬编造成「不演」。
 */
const SAFE_WORD_FALLBACK = {
  停下: '已停下：这一回合不演，只留必要的话。',
  停止: '已停下：这回合和往后都不演，只留必要的话。',
  命令: '已切到听命令模式：照你说的办。',
  人设: '已收回到人设：只按人设来。',
};

function safeWordHint(word, note) {
  const text = typeof note === 'string' ? note.trim() : '';
  if (text) return '已触发 · ' + text;
  if (word && SAFE_WORD_FALLBACK[word]) return SAFE_WORD_FALLBACK[word];
  return word ? `已触发「${word}」` : '已触发';
}

// ============================================================ 拖文件进窗口
/**
 * 这次拖拽带的是不是真文件。
 *
 * 只看 types 里有没有 Files：拖进来一段选中的文字、一个链接，都不该抢。
 */
function dragHasFiles(e) {
  const dt = e.dataTransfer;
  if (!dt || !dt.types) return false;
  return Array.from(dt.types).includes("Files");
}

/** 拖拽进出的层数：子元素之间来回穿会连发 leave/enter，用计数挡掉闪烁 */
let dragDepth = 0;

window.addEventListener("dragenter", (e) => {
  if (!dragHasFiles(e) || pick.open) return;
  e.preventDefault();
  dragDepth++;
  if (dragDepth === 1) {
    const n = e.dataTransfer.items
      ? Array.from(e.dataTransfer.items).filter((i) => i.kind === "file").length
      : (e.dataTransfer.files || []).length;
    dropDesc.textContent = n > 1 ? `${n} 个，松手就加进输入框` : "松手就加进输入框";
    dropMask.classList.add("show");
  }
});

window.addEventListener("dragover", (e) => {
  if (!dragHasFiles(e)) return;
  e.preventDefault();
  e.dataTransfer.dropEffect = "copy";
});

window.addEventListener("dragleave", (e) => {
  if (!dragHasFiles(e)) return;
  dragDepth = Math.max(0, dragDepth - 1);
  if (dragDepth === 0) dropMask.classList.remove("show");
});

window.addEventListener("drop", async (e) => {
  if (!dragHasFiles(e)) return;
  e.preventDefault();
  dragDepth = 0;
  dropMask.classList.remove("show");
  await intakeDropped(e.dataTransfer);
});

/**
 * 把拖进来的东西塞进附件条。
 *
 * 关键：渲染进程拿不到 File 的磁盘路径，只能问 preload 的 desktop.pathForFile。
 * 拿不到路径的一律跳过、一个都不猜 —— 猜错了就是把错文件喂给模型。
 */
async function intakeDropped(dt) {
  const files = Array.from(dt.files || []);
  if (!files.length) return;
  const missed = [];
  let added = 0;
  for (const f of files) {
    const path = window.desktop && window.desktop.pathForFile ? window.desktop.pathForFile(f) : "";
    if (!path) { missed.push(f.name || "（没有名字）"); continue; }
    const kind = isImg(path) ? "image" : "file";
    let dataUrl;
    if (kind === "image") {
      try {
        const r = await fetch(`/api/attach/preview?path=${encodeURIComponent(path)}`).then((x) => x.json());
        if (r && r.dataUrl) dataUrl = r.dataUrl;
      } catch {}
    }
    addAttachment({ path, name: f.name || baseName(path), kind, size: f.size, dataUrl });
    added++;
  }
  input.focus();
  if (!added && missed.length) {
    alert("这几个拿不到本机路径，加不进去：\n" + missed.join("\n") + "\n\n（文件夹要进去挑文件；网页里拖来的东西没有本机路径）");
  }
}

const STORE_KEY = 'mini-agent.sessionId';
let sessionId = null;
let sessionTitle = '';
let sessionsCache = [];
let pendingResume = false; // 插话之后要不要接着跑
let stopping = false; // 正在停止，按钮锁住别再点

/**
 * 会话 id -> 后台正在跑的那一轮。
 * 必须在这里先建好：switchSession 会在脚本后段之前就被 bootSessions 调到，
 * 用 const 写在后面会撞 TDZ，异常又被 catch 吞掉，表现成「启动后 sessionId 是 null」。
 */
var turnsInFlight = new Map();

/**
 * 把输入区彻底收拾干净，然后聚焦。
 *
 * 「清空当前 → 删会话 → 输入框点不了」那次的教训：任何一步抛异常、
 * 或者面板还开着盖在上面，input.focus() 就落空，人看着就像输入框坏了。
 * 所以这里不依赖调用链有没有抛错，该清的都清一遍。
 */
function settleComposer() {
  try {
    const dlgEl = document.getElementById('sessionsDlg');
    if (dlgEl && dlgEl.open) dlgEl.close();
  } catch {}
  stopping = false;
  busy = false;
  hideSending();
  syncSendBtn();
  // 附件选择浮层也可能残留，一并收掉
  try {
    const mask = document.getElementById('pickMask');
    if (mask && mask.classList.contains('show')) {
      mask.classList.remove('show');
      if (typeof pick !== 'undefined') pick.open = false;
    }
  } catch {}
  try {
    input.disabled = false;
    input.readOnly = false;
    input.style.pointerEvents = 'auto';
    input.focus();
  } catch {}
}

/**
 * 只把会话面板收起来、把输入框恢复成可点。
 *
 * 为什么不直接用 settleComposer：那个会把 busy 无条件清零。
 * 「当前会话正在跑、我去删了另一个会话」时，busy 不能被清掉，
 * 否则按钮从「停止」变回「发送」，人就以为跑完了。所以这里只收面板。
 */
function closeSessPanel() {
  try {
    const d = document.getElementById('sessionsDlg');
    if (d && d.open) d.close();
  } catch {}
  try {
    input.disabled = false;
    input.readOnly = false;
    input.style.pointerEvents = 'auto';
    input.focus();
  } catch {}
}

/** 正在跟着直播的那个轮询计时器（同一时刻只跟一个会话） */
var following = null;

/**
 * 从服务端把「正在跑那一轮」的内容整段补画到屏幕上。
 *
 * 用在：窗口关掉又打开、页面刷新、切回一个后台在跑的会话。
 * 服务端那边一直在缓存事件（/api/chat/live），拿到就照着画。
 *
 * @returns {Promise<boolean>} 这个会话是不是还在跑
 */
async function attachLive(id) {
  let live = null;
  try {
    live = await fetch('/api/chat/live?sessionId=' + encodeURIComponent(id)).then((r) => r.json());
  } catch {
    return false;
  }
  if (!live || !Array.isArray(live.events) || !live.events.length) return false;

  // 从服务端事件重建画面（和 runTurn 里那套一样）
  let bubble = null;
  let think = null;
  const toolEls = new Map();
  const closeThink = () => { if (think) { think.finish(); think = null; } };

  for (const ev of live.events) {
    if (ev.type === 'reasoning') {
      if (!think) think = openThink();
      think.push(ev.text);
    } else if (ev.type === 'text') {
      closeThink();
      if (!bubble) bubble = addAssistant();
      bubble.textContent += fixMojibake(ev.text);
    } else if (ev.type === 'tool_start') {
      closeThink();
      if (bubble) { bubble.classList.remove('streaming'); bubble = null; }
      const el = addTool();
      el.sum.querySelector('.name').textContent = ev.name;
      el.sum.querySelector('.status').textContent = '运行中…';
      el.pre.textContent = 'args: ' + ev.args;
      toolEls.set(ev.id, el);
    } else if (ev.type === 'tool_end') {
      const el = toolEls.get(ev.id);
      if (el) {
        const st = el.sum.querySelector('.status');
        st.textContent = ev.ok ? '完成' : '失败';
        st.className = 'status ' + (ev.ok ? 'ok' : 'err');
        el.pre.textContent += '\n--- output ---\n' + ev.output;
      }
    }
  }
  closeThink();

  if (live.running) {
    if (bubble) bubble.classList.add('streaming');
    followLive(id, live.events.length);
  }
  return Boolean(live.running);
}

/**
 * 接着跟直播：服务端还在跑就隔一会儿拉一次增量，往上追加。
 * 不重新发请求，只把「已经发生过的事」补齐——窗口关多久都不影响。
 */
function followLive(id, fromIndex) {
  if (following) clearInterval(following);
  let seen = fromIndex;

  following = setInterval(async () => {
    if (sessionId !== id) {
      clearInterval(following);
      following = null;
      return;
    }
    let live = null;
    try {
      live = await fetch('/api/chat/live?sessionId=' + encodeURIComponent(id)).then((r) => r.json());
    } catch {
      return;
    }
    const evs = live.events || [];
    if (evs.length > seen) {
      let bubble = null;
      let think = null;
      const closeThink = () => { if (think) { think.finish(); think = null; } };
      const bubbles = document.querySelectorAll('.assistant .bubble');
      bubble = bubbles.length ? bubbles[bubbles.length - 1] : null;
      if (bubble) bubble.classList.add('streaming');

      for (const ev of evs.slice(seen)) {
        if (ev.type === 'reasoning') {
          if (!think) think = openThink();
          think.push(ev.text);
        } else if (ev.type === 'text') {
          closeThink();
          if (!bubble) bubble = addAssistant();
          bubble.textContent += fixMojibake(ev.text);
        }
      }
      closeThink();
      seen = evs.length;
      log.scrollTop = log.scrollHeight;
    }
    if (!live.running) {
      clearInterval(following);
      following = null;
      const bubbles = document.querySelectorAll('.assistant .bubble');
      if (bubbles.length) bubbles[bubbles.length - 1].classList.remove('streaming');
      busy = false;
      hideSending();
      syncSendBtn();
      refreshSessions({ silent: true }).catch(() => {});
    }
  }, 1200);
}

/**
 * 连接断了之后试着自愈：
 *   1) 服务端还在跑 → 清屏重画、从直播缓存补到最新，然后接着跟
 *   2) 已经跑完 → 拉完整历史重画
 *   3) 服务端连不上 → 返回 false，让调用方按人话报错
 *
 * @returns {Promise<boolean>} 有没有自愈成功
 */
async function tryHealAfterDisconnect(id) {
  for (let i = 0; i < 4; i++) {
    await new Promise((r) => setTimeout(r, 600 * (i + 1)));

    const alive = await fetch('/api/health').then((r) => r.ok).catch(() => false);
    if (!alive) continue;

    const running = await fetch('/api/running').then((r) => r.json()).catch(() => null);
    const isRunning = Boolean(running && running.running && running.running.some((x) => x.sessionId === id));

    if (isRunning) {
      if (sessionId === id) {
        log.innerHTML = '';
        const stillRunning = await attachLive(id);
        busy = stillRunning;
        if (stillRunning) showSending();
        else hideSending();
        syncSendBtn();
      }
      return true;
    }

    const sel = await fetch('/api/sessions/select', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    }).then((r) => r.json()).catch(() => null);

    if (sel && sel.session) {
      if (sessionId === id) {
        renderTurns(sel.session.turns);
        busy = false;
        hideSending();
        syncSendBtn();
      }
      const hasAnswer = (sel.session.turns || []).some((t) => t.role === 'assistant' && String(t.text || '').trim());
      if (hasAnswer) return true;
    }
    return false;
  }
  return false;
}

