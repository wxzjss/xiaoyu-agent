    .sessMain { flex: 1; min-width: 0; }
    .sessTitle { font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sessSub { color: var(--dim); font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sessRow .mini {
