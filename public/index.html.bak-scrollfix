    }
    .featName .badge.off { color: var(--dim); border-color: var(--border); }
    .featDesc { color: var(--dim); font-size: 11.5px; line-height: 1.7; margin-top: 2px; }
    .featRow .switch {
      flex: none; min-width: 76px; height: 30px; border-radius: 999px; cursor: pointer;
      border: 1px solid var(--border); background: transparent; color: var(--dim);
      font-size: 12.5px; padding: 0 12px;
