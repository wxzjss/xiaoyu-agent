<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>小鱼</title>
  <style>
    /* 滚动条：暗色细条，别跟背景打架 */
    * { scrollbar-width: thin; scrollbar-color: #2c333f transparent; }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: #2c333f; border-radius: 8px;
      border: 2px solid transparent; background-clip: content-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: #3b4553; background-clip: content-box; }
    ::-webkit-scrollbar-thumb:active { background: #4a5568; background-clip: content-box; }
    ::-webkit-scrollbar-corner { background: transparent; }

    :root {
      --bg: #0f1115;
      --panel: #171a21;
      --border: #262b36;
      --text: #e6e9ef;
      --dim: #8b95a7;
      --accent: #4f8cff;
      --ok: #3fb950;
      --err: #f85149;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; height: 100vh; display: flex; flex-direction: column;
      background: var(--bg); color: var(--text);
      font: 14px/1.6 -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
    }
    header {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--panel);
    }
    header b { font-size: 15px; }
    header .meta { color: var(--dim); font-size: 12px; }
    /* 按钮组整体靠右：空隙全塞在状态条后面，别再让每个按钮各抢一份 auto */
    header #meta { margin-left: 4px; margin-right: auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    header button {
      background: transparent; color: var(--dim);
      border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer;
    }
    header button:hover { color: var(--text); border-color: var(--dim); }
    #log {
      flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      padding: 20px; display: flex; flex-direction: column; gap: 14px;
    }
    .msg { max-width: 900px; width: 100%; margin: 0 auto; }
    .role { font-size: 12px; color: var(--dim); margin-bottom: 4px; }
    .user .bubble {
      background: #1d2430; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px;
      white-space: pre-wrap; word-break: break-word;
    }
    .assistant .bubble { white-space: pre-wrap; word-break: break-word; }
    .assistant .bubble.streaming::after { content: "▍"; color: var(--accent); animation: blink 1s steps(2) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    details.tool {
      max-width: 900px; width: 100%; margin: 0 auto;
      border: 1px solid var(--border); border-radius: 8px; background: var(--panel);
    }
    details.tool summary {
      cursor: pointer; padding: 7px 10px; font-family: ui-monospace, Consolas, monospace; font-size: 12.5px;
      color: var(--dim); list-style: none; display: flex; gap: 8px; align-items: center;
    }
    details.tool summary::-webkit-details-marker { display: none; }
    details.tool summary .name { color: var(--accent); }
    details.tool summary .status.ok { color: var(--ok); }
    details.tool summary .status.err { color: var(--err); }
    details.tool pre {
      margin: 0; padding: 8px 10px; border-top: 1px solid var(--border);
      font-family: ui-monospace, Consolas, monospace; font-size: 12.5px;
      white-space: pre-wrap; word-break: break-word; max-height: 320px; overflow: auto; color: #c9d1d9;
    }
    details.think {
      border: 1px solid var(--border); border-radius: 8px; background: rgba(23, 26, 33, .72);
      font-size: 12.5px;
    }
    details.think > summary {
      list-style: none; cursor: pointer; padding: 7px 10px; color: var(--dim);
      display: flex; gap: 8px; align-items: center; user-select: none;
    }
    details.think > summary::-webkit-details-marker { display: none; }
    details.think > summary::before {
      content: '▸'; color: var(--dim); font-size: 11px; flex: none;
      transition: transform .12s ease;
    }
    details.think[open] > summary::before { transform: rotate(90deg); }
    details.think > summary:hover { color: var(--text); }
    details.think .thinkTitle { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    details.think .thinkMeta { flex: none; color: var(--dim); opacity: .65; font-size: 11.5px; }
    details.think .thinkBody {
      padding: 8px 10px 10px; border-top: 1px solid var(--border);
      color: var(--dim); font-style: italic; white-space: pre-wrap; word-break: break-word;
    }
    .interjectTag {
      display: inline-block; font-size: 12px; color: var(--accent);
      border: 1px solid var(--accent); border-radius: 999px; padding: 1px 9px; margin-left: 8px;
    }
    footer { padding: 12px 16px 16px; border-top: 1px solid var(--border); background: var(--panel); }
    .inputRow { max-width: 900px; margin: 0 auto; display: flex; gap: 10px; align-items: flex-end; }

    /* 加号：贴在输入框左边 */
    .plusWrap { position: relative; flex: 0 0 auto; }
    #plusBtn {
      width: 44px; height: 44px; padding: 0; border: 1px solid var(--border); border-radius: 8px;
      background: #0f1319; color: var(--text); font-size: 22px; line-height: 1; cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: border-color .15s, color .15s;
    }
    #plusBtn:hover { border-color: var(--accent); color: var(--accent); }
    #plusBtn[aria-expanded="true"] { border-color: var(--accent); color: var(--accent); }
    #plusBtn:disabled { opacity: .45; cursor: not-allowed; }
    .plusMenu {
      position: absolute; left: 0; bottom: calc(100% + 8px); min-width: 168px; z-index: 60;
      background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 6px;
      box-shadow: 0 8px 28px rgba(0,0,0,.45); display: none;
    }
    .plusMenu.open { display: block; }
    .plusMenu button {
      display: flex; align-items: center; gap: 9px; width: 100%; padding: 9px 10px; border: 0;
      border-radius: 7px; background: transparent; color: var(--text); font: inherit; font-size: 13.5px;
      cursor: pointer; text-align: left;
    }
    .plusMenu button:hover { background: #1b2129; color: var(--accent); }
    .plusMenu .ico { font-size: 15px; width: 18px; text-align: center; }
    .plusMenu .sub { color: var(--dim); font-size: 11.5px; margin-left: auto; }

    /* 已选附件条：输入框上方，一列小卡片 */
    .attachBar { max-width: 900px; margin: 0 auto 8px; display: none; flex-wrap: wrap; gap: 8px; }
    .attachBar.show { display: flex; }
    .attachChip {
      display: flex; align-items: center; gap: 8px; max-width: 260px; padding: 5px 8px 5px 6px;
      background: #0f1319; border: 1px solid var(--border); border-radius: 8px; font-size: 12.5px;
    }
    .attachChip .thumb {
      width: 26px; height: 26px; border-radius: 5px; object-fit: cover; flex: 0 0 auto;
      background: #1b2129; display: block;
    }
    .attachChip .ficon {
      width: 26px; height: 26px; border-radius: 5px; background: #1b2129; color: var(--dim);
      display: flex; align-items: center; justify-content: center; font-size: 12px; flex: 0 0 auto;
    }
    .attachChip .aname {
      flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .attachChip .asize { color: var(--dim); font-size: 11px; flex: 0 0 auto; }
    .attachChip .arm {
      flex: 0 0 auto; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 4px;
      background: transparent; color: var(--dim); cursor: pointer; font-size: 14px; line-height: 1;
    }
    .attachChip .arm:hover { background: #2a1a1a; color: var(--err); }

    /* 消息里带的附件 */
    .msgAttach { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }

    /* 拖文件进来时的全屏提示：只提示，不挡鼠标（指针事件全放过） */
    .dropMask {
      position: fixed; inset: 0; z-index: 900; display: none;
      align-items: center; justify-content: center; padding: 40px;
      background: rgba(8, 10, 14, .72); backdrop-filter: blur(10px);
      pointer-events: none;
    }
    .dropMask.show { display: flex; animation: dropFade .16s ease-out; }
    @keyframes dropFade { from { opacity: 0; } to { opacity: 1; } }
    .dropWrap {
      display: flex; flex-direction: column; align-items: center; text-align: center;
      color: var(--text); margin-top: -3%;
    }
    .dropArt { width: 138px; height: 100px; color: var(--accent); }
    .dropTitle { font-size: 17px; font-weight: 600; margin-top: 14px; }
    .dropDesc { font-size: 13px; color: var(--dim); margin-top: 8px; }

    /* 栏式浏览浮层（照 dsh 那个样子） */
    .pickMask {
      position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 200;
      display: none; align-items: center; justify-content: center; padding: 24px;
    }
    .pickMask.open { display: flex; }
    .pickBox {
      width: min(860px, 100%); height: min(560px, 82vh); display: flex; flex-direction: column;
      background: var(--panel); border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    }
    .pickHead {
      display: flex; align-items: center; gap: 8px; padding: 10px 12px;
      border-bottom: 1px solid var(--border); flex: 0 0 auto;
    }
    .pickHead .ptitle { font-size: 13.5px; font-weight: 600; flex: 0 0 auto; }
    .pickHead .pcrumb {
      flex: 1; min-width: 0; background: #0f1319; color: var(--text);
      border: 1px solid var(--border); border-radius: 6px; padding: 5px 9px;
      font: inherit; font-size: 12px; outline: none;
    }
    .pickHead .pcrumb:focus { border-color: var(--accent); }
    .pickHead button {
      border: 1px solid var(--border); background: #0f1319; color: var(--text);
      border-radius: 6px; padding: 5px 10px; font-size: 12px; cursor: pointer; flex: 0 0 auto;
    }
    .pickHead button:hover { border-color: var(--accent); color: var(--accent); }

    /* 面包屑：路径本身就点得动，点哪段回到哪层 */
    .pickCrumbs {
      display: flex; align-items: center; gap: 2px; flex-wrap: nowrap; overflow-x: auto;
      padding: 6px 12px; border-bottom: 1px solid var(--border); flex: 0 0 auto;
      scrollbar-width: none;
    }
    .pickCrumbs::-webkit-scrollbar { display: none; }
    .pickCrumbs .pcsep { color: var(--dim); font-size: 12px; flex: 0 0 auto; }
    .pickCrumbs .pcseg {
      border: 0; background: transparent; color: var(--dim); font: inherit; font-size: 12px;
      padding: 2px 5px; border-radius: 4px; cursor: pointer; flex: 0 0 auto; max-width: 220px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .pickCrumbs .pcseg:hover { background: #1b2129; color: var(--text); }
    .pickCrumbs .pcseg.cur { color: var(--text); font-weight: 600; }

    /* 多栏并排，一栏一层目录，横着滚 */
    .pickCols {
      flex: 1; min-height: 0; display: flex; overflow-x: auto; overflow-y: hidden;
      padding: 6px; gap: 6px;
    }
    .pickCol {
      flex: 0 0 232px; min-width: 232px; overflow-y: auto; overflow-x: hidden;
      border-right: 1px solid var(--border); padding-right: 4px;
    }
    .pickCol:last-child { border-right: 0; }
    .pickRow {
      display: flex; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 6px;
      cursor: pointer; font-size: 13px; user-select: none;
    }
    .pickRow:hover { background: #1b2129; }
    .pickRow.sel { background: #17222e; box-shadow: inset 0 0 0 1px var(--accent); }
    .pickRow .pico { flex: 0 0 auto; width: 18px; text-align: center; font-size: 13px; }
    .pickRow .pname {
      flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .pickRow .pmeta { color: var(--dim); font-size: 11px; flex: 0 0 auto; }
    .pickRow .pgo { color: var(--dim); flex: 0 0 auto; font-size: 15px; line-height: 1; width: 10px; text-align: right; }
    .pickRow:hover .pgo { color: var(--accent); }
    .pickRow.sel .pgo { color: var(--accent); }
    .pickRow img { width: 24px; height: 24px; border-radius: 4px; object-fit: cover; flex: 0 0 auto; }

    .pickFoot {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px;
      border-top: 1px solid var(--border); flex: 0 0 auto;
    }
    .pickFoot .pcheck {
      display: flex; align-items: center; gap: 6px; color: var(--dim); font-size: 12px;
      cursor: pointer; flex: 0 0 auto; user-select: none;
    }
    .pickFoot .pnote { flex: 1; color: var(--dim); font-size: 12px; min-width: 0; }
    .pickFoot button {
      border: 0; border-radius: 7px; padding: 8px 16px; font-size: 13px; cursor: pointer;
      background: var(--accent); color: #fff; font-weight: 600;
    }
    .pickFoot button.ghost2 { background: transparent; color: var(--dim); font-weight: 400; padding: 8px 12px; }
    .pickFoot button.ghost2:hover { color: var(--text); }
    .pickEmpty { padding: 26px; text-align: center; color: var(--dim); font-size: 12.5px; }
    textarea {
      flex: 1; resize: none; min-height: 44px; max-height: 180px; padding: 10px 12px;
      background: #0f1319; color: var(--text); border: 1px solid var(--border); border-radius: 8px;
      font: inherit; outline: none;
    }
    textarea:focus { border-color: var(--accent); }
    #send {
      height: 44px; padding: 0 18px; border: 0; border-radius: 8px; background: var(--accent);
      color: #fff; font-weight: 600; cursor: pointer;
    }
    #send.stop { background: var(--err); }
    #send.stop::after { content: none; }
.usage { max-width: 900px; margin: 0 auto; color: var(--dim); font-size: 12px; text-align: right; }
    /* 正在发送消息…… — 只在生成中出现，结束后立刻拿掉 */
    .sendingHint {
      max-width: 900px; margin: 0 auto 6px; color: var(--dim); font-size: 12px;
      display: none; align-items: center; gap: 6px;
    }
    .sendingHint.show { display: flex; }
    .sendingHint .dots::after {
      content: ''; animation: sendingDots 1.4s steps(4, end) infinite;
    }
    @keyframes sendingDots {
      0%   { content: ''; }
      25%  { content: '.'; }
      50%  { content: '..'; }
      75%  { content: '...'; }
      100% { content: ''; }
    }

    /* 每轮底部那行 token 小字 */
    .turnUsage {
      max-width: 900px; margin: 2px auto 12px; padding-left: 2px;
      color: var(--dim); font-size: 11.5px; line-height: 1.5;
      font-variant-numeric: tabular-nums; user-select: text; opacity: .8;
    }
    .turnUsage .sep { opacity: .5; margin: 0 6px; }
    .turnUsage .tt { color: #8fc7ff; }

    /* 左上角：模型框 + 思考强度框 */
    .topCfg { display: flex; align-items: center; gap: 8px; margin-left: 2px; }
    .cfgBox {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 10px; border: 1px solid var(--border); border-radius: 8px;
      background: #0f1319; color: var(--text); font: inherit; font-size: 12.5px;
      cursor: pointer; white-space: nowrap; max-width: 260px;
      transition: border-color .15s, color .15s;
    }
    .cfgBox:hover { border-color: var(--accent); color: var(--accent); }
    .cfgBox.open { border-color: var(--accent); color: var(--accent); }
    .cfgBox .caret { font-size: 10px; color: var(--dim); flex: 0 0 auto; }
    .cfgBox:hover .caret, .cfgBox.open .caret { color: var(--accent); }
    .cfgBox #topModelName, .cfgBox #topThinkName {
      max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    /* 不是默认值的时候标出来，一眼能看出「这个会话被我改过」 */
    .cfgBox.custom { border-color: #4a6b8a; }
    .cfgBox.custom #topThinkName, .cfgBox.custom #topModelName { color: #8fc7ff; }

    /* 下拉浮层 */
    .cfgMenu {
      position: fixed; z-index: 320; display: none; min-width: 220px; max-width: 320px;
      max-height: 60vh; overflow: auto; padding: 6px;
      background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
      box-shadow: 0 10px 34px rgba(0,0,0,.5);
    }
    .cfgMenu.open { display: block; }
    .cfgMenuHead {
      color: var(--dim); font-size: 11.5px; padding: 6px 10px 8px; border-bottom: 1px solid var(--border);
      margin-bottom: 4px;
    }
    .cfgMenuItem {
      display: flex; align-items: center; gap: 8px; width: 100%; padding: 8px 10px;
      border: 0; border-radius: 7px; background: transparent; color: var(--text);
      font: inherit; font-size: 13px; cursor: pointer; text-align: left;
    }
    .cfgMenuItem:hover { background: #1b2129; color: var(--accent); }
    .cfgMenuItem .ck { width: 14px; color: var(--accent); flex: 0 0 auto; }
    .cfgMenuItem .desc { color: var(--dim); font-size: 11px; margin-left: auto; flex: 0 0 auto; }

    /* 人设可选栏：一排卡片，点一下就切过去 */
    .pList { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .pCard {
      position: relative; min-width: 132px; max-width: 220px; padding: 8px 26px 8px 10px;
      border: 1px solid var(--border); border-radius: 9px; background: #0f1319; cursor: pointer;
      display: flex; flex-direction: column; gap: 3px; transition: border-color .15s, background .15s;
    }
    .pCard:hover { border-color: var(--accent); }
    .pCard.on { border-color: var(--accent); background: #17222e; box-shadow: inset 0 0 0 1px var(--accent); }
    .pCard .pName {
      font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pCard .pMeta { font-size: 11px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pCard .pTag {
      position: absolute; top: 6px; right: 7px; font-size: 9.5px; color: var(--accent);
      border: 1px solid currentColor; border-radius: 4px; padding: 0 4px; line-height: 14px;
    }
    .pCard .pDel {
      position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; line-height: 16px;
      border: 0; border-radius: 4px; background: transparent; color: var(--dim); cursor: pointer; font-size: 13px;
    }
    .pCard .pDel:hover { background: #2a1a1a; color: var(--err); }
    .pCard.on .pDel { right: 30px; }
    .pTools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* 改名小框：自己画，不用 prompt（Electron 里 prompt 不弹） */
    .askDlg {
      width: min(420px, 88vw); padding: 0; border: 1px solid var(--border); border-radius: 12px;
      background: var(--panel); color: var(--text); overflow: hidden;
    }
    .askDlg::backdrop { background: rgba(0,0,0,.55); }
    .askHead {
      display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border);
      font-size: 13.5px; font-weight: 600;
    }
    .askBody { padding: 14px 16px; }
    .askBody input {
      width: 100%; box-sizing: border-box; padding: 9px 11px; border-radius: 8px;
      border: 1px solid var(--border); background: #0f1319; color: var(--text);
      font: inherit; font-size: 13.5px; outline: none;
    }
    .askBody input:focus { border-color: var(--accent); }
    .askHint { color: var(--dim); font-size: 12px; margin-top: 8px; min-height: 16px; }
    .askFoot {
      display: flex; justify-content: flex-end; gap: 8px; padding: 10px 16px;
      border-top: 1px solid var(--border);
    }
    .askFoot button {
      border: 0; border-radius: 7px; padding: 8px 16px; font-size: 13px; cursor: pointer;
      background: var(--accent); color: #fff; font-weight: 600;
    }
    .askFoot button.ghost3 { background: transparent; color: var(--dim); font-weight: 400; }
    .askFoot button.ghost3:hover { color: var(--text); }

    /* settings dialog */
    dialog {
      width: min(760px, 92vw); max-height: 86vh; padding: 0; border: 1px solid var(--border);
      border-radius: 12px; background: var(--panel); color: var(--text); overflow: hidden;
    }
    dialog::backdrop { background: rgba(0,0,0,.55); }
    .dlgHead {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 16px; border-bottom: 1px solid var(--border);
    }
    .dlgHead b { font-size: 15px; }
    .dlgHead .x {
      margin-left: auto; background: transparent; border: 1px solid var(--border); color: var(--dim);
      border-radius: 6px; padding: 3px 10px; cursor: pointer;
    }
    .dlgBody { padding: 16px; overflow-y: auto; max-height: calc(86vh - 110px); }
    .dlgFoot {
      display: flex; gap: 10px; align-items: center;
      padding: 12px 16px; border-top: 1px solid var(--border);
    }
    .dlgFoot .hint { color: var(--dim); font-size: 12px; margin-right: auto; }
    fieldset { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; margin: 0 0 14px; }
    legend { padding: 0 6px; color: var(--accent); font-size: 13px; }
    .field { margin-bottom: 12px; }
    .field:last-child { margin-bottom: 0; }
    .field label { display: block; font-size: 12.5px; color: var(--dim); margin-bottom: 6px; }
    .field textarea {
      width: 100%; min-height: 120px; max-height: 300px; resize: vertical;
      background: #0f1319; color: var(--text); border: 1px solid var(--border);
      border-radius: 8px; padding: 10px 12px; font: 13px/1.65 inherit;
      font-family: inherit; outline: none;
    }
    .field textarea:focus { border-color: var(--accent); }
    .field input[type=text] {
      width: 100%; background: #0f1319; color: var(--text); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; font: inherit; outline: none;
    }
    .field input[type=text]:focus { border-color: var(--accent); }
    .primary {
      height: 36px; padding: 0 16px; border: 0; border-radius: 8px;
      background: var(--accent); color: #fff; font-weight: 600; cursor: pointer;
    }
