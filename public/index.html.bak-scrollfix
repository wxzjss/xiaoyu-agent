function paintTopCfg() {
  topModelName.textContent = cfgState.modelName || '没配模型';
  topThinkName.textContent = cfgState.levelName || '默认';
  // 会话自定义过的，框变个色，免得忘了自己改过
  topModel.classList.toggle('custom', Boolean(cfgState.isModelCustom));
  topThink.classList.toggle('custom', Boolean(cfgState.isLevelCustom));
